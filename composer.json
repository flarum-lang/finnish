{
	"name": "flarum-lang/finnish",
	"description": "Finnish Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/finnish",
	"license": "MIT",
	"authors": [
		{
			"name": "MarkoKaartinen",
			"homepage": "https://github.com/MarkoKaartinen",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/finnish/issues",
		"forum": "https://discuss.flarum.org/d/28810",
		"source": "https://github.com/flarum-lang/finnish"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Finnish",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#ffffff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "fi",
			"title": "Suomi"
		}
	}
}
